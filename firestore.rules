rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /payments/{paymentId} {
      allow read: if isAdmin();
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    match /websites/{websiteId} {
      function safeWebsiteData() {
        return request.resource.data.keys().hasOnly([
          'name','phone','type','address','title','desc','createdAt','updatedAt',
          'domain','websiteId','packageName','packageAmount','billing','template','theme',
          'ownerId','status','paid','subscriptionStatus'
        ])
        && request.resource.data.websiteId == websiteId
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'preview'
        && request.resource.data.paid == false
        && request.resource.data.subscriptionStatus == 'pending_payment';
      }
      function isOwner() {
        return request.auth != null
          && resource.data.ownerId != null
          && request.auth.uid == resource.data.ownerId
          && request.resource.data.ownerId == resource.data.ownerId;
      }
      allow create: if request.auth != null && safeWebsiteData();
      allow update: if request.auth != null && safeWebsiteData() && isOwner();
      allow get: if resource.data.status == 'live' || resource.data.status == 'preview';
      allow list: if false;
      allow delete: if isAdmin();
    }

    match /trainingApplications/{applicationId} {
      allow read, update: if isAdmin();
      allow create, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
