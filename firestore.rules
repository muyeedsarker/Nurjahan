rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /payments/{paymentId} {
      allow read: if isAdmin();
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    match /websites/{websiteId} {
      function safeWebsiteData() {
        return request.resource.data.keys().hasOnly([
          'name','phone','type','address','title','desc','createdAt','updatedAt',
          'domain','websiteId','packageName','packageAmount','billing','template','theme','ownerId'
        ])
        && !request.resource.data.keys().hasAny(['status','paid','subscriptionStatus'])
        && request.resource.data.websiteId == websiteId;
      }
      function isOwner() {
        return request.auth != null
          && resource.data.ownerId != null
          && request.auth.uid == resource.data.ownerId
          && request.resource.data.ownerId == resource.data.ownerId;
      }
      allow create: if safeWebsiteData();
      allow update: if safeWebsiteData() && (isOwner() || !resource.data.keys().hasAny(['ownerId']));
      allow get: if resource.data.status == 'live';
      allow list: if false;
      allow delete: if isAdmin();
    }

    match /trainingApplications/{applicationId} {
      allow read, update: if isAdmin();
      allow create, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
