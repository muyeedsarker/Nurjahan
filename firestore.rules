rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function safeWebsiteData() {
      return request.resource.data.keys().hasOnly([
        'name','phone','type','address','title','desc','createdAt','updatedAt',
        'domain','websiteId','packageName','packageAmount','billing','websiteId'
      ])
      && !request.resource.data.keys().hasAny([
        'status','paid','subscriptionStatus'
      ])
      && request.resource.data.websiteId == websiteId;
    }

    match /payments/{paymentId} {
      allow read: if isAdmin();
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    match /websites/{websiteId} {
      // Builder can create/update only the customer's own safe draft fields.
      // Protected live/payment fields can never be written by the public client.
      allow create: if safeWebsiteData();
      allow update: if safeWebsiteData();
      allow get: if resource.data.status == 'live';
      allow list: if false;
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
